{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-agent-kit.dev/schemas/prd-ir.schema.json",
  "title": "Structured PRD Intermediate Representation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document", "sources", "sections", "requirements", "assets", "open_questions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document": {"$ref": "#/$defs/document"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}, "uniqueItems": true},
    "sections": {"type": "array", "items": {"$ref": "#/$defs/block"}},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "open_questions": {"type": "array", "items": {"$ref": "#/$defs/openQuestion"}}
  },
  "$defs": {
    "status": {"enum": ["confirmed", "provisional", "unknown", "deprecated"]},
    "sourceRef": {"type": "string", "pattern": "^SRC-[A-Za-z0-9._-]+$"},
    "sourceRefs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}, "uniqueItems": true},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "title", "domain", "version", "status", "profile_ref"],
      "properties": {
        "document_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "title": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "ready_for_review", "confirmed"]},
        "profile_ref": {"type": "string", "minLength": 1}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "type", "status", "source_refs"],
      "properties": {
        "block_id": {"type": "string", "pattern": "^BLOCK-[A-Za-z0-9._-]+$"},
        "type": {"enum": ["heading", "paragraph", "bullet_list", "ordered_list", "callout", "table", "custom"]},
        "level": {"type": "integer", "minimum": 1, "maximum": 6},
        "text": {"type": "string"},
        "data": {"type": "object"},
        "status": {"$ref": "#/$defs/status"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "logicKind": {
      "oneOf": [
        {"enum": ["added_content", "trigger", "field_source", "display_rule", "interaction_rule", "branch", "validation", "permission", "boundary", "metric_formula", "default_value", "data_migration", "system_boundary"]},
        {"type": "string", "pattern": "^x-[a-z0-9][a-z0-9-]*$"}
      ]
    },
    "logic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logic_id", "kind", "text", "status", "source_refs", "children"],
      "properties": {
        "logic_id": {"type": "string", "pattern": "^LOGIC-[A-Za-z0-9._-]+$"},
        "kind": {"$ref": "#/$defs/logicKind"},
        "text": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/logic"}}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"const": "confirmed"},
              "kind": {"enum": ["field_source", "default_value", "permission", "metric_formula", "validation", "data_migration", "system_boundary"]}
            },
            "required": ["status", "kind"]
          },
          "then": {"properties": {"source_refs": {"minItems": 1}}}
        }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "sequence", "module", "status", "prototype_asset_refs", "logic", "source_refs"],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^REQ-[A-Za-z0-9._-]+$"},
        "sequence": {"type": "integer", "minimum": 1},
        "module": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "status": {"$ref": "#/$defs/status"},
        "prototype_asset_refs": {"type": "array", "items": {"type": "string", "pattern": "^ASSET-[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "logic": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/logic"}},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "type", "source", "alt", "status"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^ASSET-[A-Za-z0-9._-]+$"},
        "type": {"enum": ["image", "diagram", "file"]},
        "source": {"type": "string", "minLength": 1},
        "alt": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "question", "blocking", "status", "answer", "source_refs"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^Q-[A-Za-z0-9._-]+$"},
        "question": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"},
        "status": {"enum": ["open", "resolved"]},
        "answer": {"type": ["string", "null"]},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    }
  }
}
